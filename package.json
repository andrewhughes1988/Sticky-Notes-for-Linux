{
  "name": "com.netsysprep.stickynotes",
  "version": "1.0.0",
  "description": "Pixel-faithful Windows Sticky Notes app for Linux with local database and cloud sync readiness",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.node.json",
    "start": "npm run build && electron .",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "test": "ELECTRON_RUN_AS_NODE=1 electron --import tsx tests/database.test.ts",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "keywords": [
    "sticky-notes",
    "linux",
    "onenote",
    "kde",
    "wayland",
    "offline-first"
  ],
  "author": {
    "name": "Andrew Hughes",
    "email": "your-email@example.com"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dompurify": "^3.2.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.netsysprep.stickynotes",
    "productName": "Sticky Notes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": ["*.png", "icons/*.png"]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icons",
      "executableName": "sticky-notes-linux",
      "desktop": {
        "entry": {
          "Icon": "com.netsysprep.stickynotes",
          "StartupWMClass": "com.netsysprep.stickynotes"
        }
      },
      "synopsis": "Sticky Notes app for Linux",
      "description": "A Sticky Notes app for Linux with local database"
    },
    "deb": {
      "packageName": "sticky-notes-linux",
      "artifactName": "sticky-notes-linux_${version}_${arch}.${ext}",
      "fpm": [
        "build/metainfo/com.netsysprep.stickynotes.metainfo.xml=/usr/share/metainfo/com.netsysprep.stickynotes.metainfo.xml",
        "build/icons/16x16.png=/usr/share/icons/hicolor/16x16/apps/com.netsysprep.stickynotes.png",
        "build/icons/24x24.png=/usr/share/icons/hicolor/24x24/apps/com.netsysprep.stickynotes.png",
        "build/icons/32x32.png=/usr/share/icons/hicolor/32x32/apps/com.netsysprep.stickynotes.png",
        "build/icons/48x48.png=/usr/share/icons/hicolor/48x48/apps/com.netsysprep.stickynotes.png",
        "build/icons/64x64.png=/usr/share/icons/hicolor/64x64/apps/com.netsysprep.stickynotes.png",
        "build/icons/128x128.png=/usr/share/icons/hicolor/128x128/apps/com.netsysprep.stickynotes.png",
        "build/icons/256x256.png=/usr/share/icons/hicolor/256x256/apps/com.netsysprep.stickynotes.png",
        "build/icons/512x512.png=/usr/share/icons/hicolor/512x512/apps/com.netsysprep.stickynotes.png",
        "build/icons/1024x1024.png=/usr/share/icons/hicolor/1024x1024/apps/com.netsysprep.stickynotes.png"
      ],
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh"
    }
  }
}
