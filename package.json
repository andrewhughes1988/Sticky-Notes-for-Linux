{
  "name": "com.netsysprep.stickynotes",
  "desktopName": "sticky-notes-linux.desktop",
  "version": "1.2.0",
  "description": "Pixel-faithful Windows Sticky Notes app for Linux backed by a local SQLite database",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "build": "npm run typecheck && vite build",
    "start": "npm run build && electron --ozone-platform=x11 --class=com.netsysprep.stickynotes .",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "patch-package --error-on-fail && electron-builder install-app-deps",
    "test": "ELECTRON_RUN_AS_NODE=1 electron --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewhughes1988/Sticky-Notes-for-Linux.git"
  },
  "homepage": "https://github.com/andrewhughes1988/Sticky-Notes-for-Linux#readme",
  "bugs": {
    "url": "https://github.com/andrewhughes1988/Sticky-Notes-for-Linux/issues"
  },
  "keywords": [
    "sticky-notes",
    "linux",
    "kde",
    "wayland",
    "offline-first"
  ],
  "author": {
    "name": "Andrew Hughes",
    "email": "andrew.hughes@netsysprep.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-task-item": "^3.35.0",
    "@tiptap/extension-task-list": "^3.35.0",
    "@tiptap/extension-underline": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "better-sqlite3": "^13.2.0",
    "dompurify": "^3.4.18",
    "lucide-react": "^0.475.0",
    "parse5": "^8.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.4.1",
    "electron-builder": "26.18.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.netsysprep.stickynotes",
    "productName": "Sticky Notes",
    "afterPack": "scripts/after-pack-fuses.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "*.png",
          "icons/*.png"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icons",
      "executableName": "sticky-notes-linux",
      "executableArgs": [
        "--ozone-platform=x11",
        "--class=com.netsysprep.stickynotes"
      ],
      "desktop": {
        "entry": {
          "Icon": "com.netsysprep.stickynotes",
          "StartupWMClass": "com.netsysprep.stickynotes"
        }
      },
      "synopsis": "Sticky Notes app for Linux",
      "description": "A Sticky Notes app for Linux with local database"
    },
    "appImage": {
      "artifactName": "Sticky.Notes-${version}.${ext}",
      "executableArgs": [
        "--ozone-platform=x11",
        "--class=com.netsysprep.stickynotes"
      ]
    },
    "deb": {
      "packageName": "sticky-notes-linux",
      "artifactName": "sticky-notes-linux_${version}_${arch}.${ext}",
      "fpm": [
        "build/metainfo/com.netsysprep.stickynotes.metainfo.xml=/usr/share/metainfo/com.netsysprep.stickynotes.metainfo.xml",
        "build/icons/16x16.png=/usr/share/icons/hicolor/16x16/apps/com.netsysprep.stickynotes.png",
        "build/icons/24x24.png=/usr/share/icons/hicolor/24x24/apps/com.netsysprep.stickynotes.png",
        "build/icons/32x32.png=/usr/share/icons/hicolor/32x32/apps/com.netsysprep.stickynotes.png",
        "build/icons/48x48.png=/usr/share/icons/hicolor/48x48/apps/com.netsysprep.stickynotes.png",
        "build/icons/64x64.png=/usr/share/icons/hicolor/64x64/apps/com.netsysprep.stickynotes.png",
        "build/icons/128x128.png=/usr/share/icons/hicolor/128x128/apps/com.netsysprep.stickynotes.png",
        "build/icons/256x256.png=/usr/share/icons/hicolor/256x256/apps/com.netsysprep.stickynotes.png",
        "build/icons/512x512.png=/usr/share/icons/hicolor/512x512/apps/com.netsysprep.stickynotes.png",
        "build/icons/1024x1024.png=/usr/share/icons/hicolor/1024x1024/apps/com.netsysprep.stickynotes.png"
      ],
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh"
    }
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch@>=7 <11": "^11.0.9"
    }
  }
}
